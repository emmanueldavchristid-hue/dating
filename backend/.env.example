# Copier en .env et adapter. Ne jamais committer le .env.
APP_NAME=Sortie
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://sortie:sortie@localhost:5432/sortie
# Obligatoire en production : chaîne aléatoire longue (ex. `openssl rand -hex 32`)
JWT_SECRET=dev-only-change-me-please-32-bytes-min
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
TIMEZONE=Africa/Abidjan
DEFAULT_CITY=abidjan

# Itinéraires : none (aucun temps de trajet affiché) | osrm
ROUTING_PROVIDER=none
OSRM_URL=
# Concierge IA (clés uniquement côté serveur, jamais dans le dépôt). Vide = mode règles, l'app marche sans.
# Ordre de repli : si le premier est saturé ou en panne, le suivant répond.
LLM_PROVIDERS=
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Paiement : none tant qu'aucun agrégateur Mobile Money n'est intégré
PAYMENTS_PROVIDER=none
MAP_PROVIDER=osm
# URL publique du bucket S3 / CDN pour les photos (vide = visuels générés)
MEDIA_BASE_URL=

SEARCH_HISTORY_RETENTION_DAYS=30
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# RAG : hashing (hors ligne, lexical enrichi) | fastembed (sémantique, pip install -r requirements-ai.txt)
EMBEDDINGS_PROVIDER=hashing
# Photos Google Places (New) : option DÉSACTIVÉE par défaut, payante au-delà d'un quota gratuit.
# Lire docs/GOOGLE-PHOTOS.md avant d'activer. La clé se met uniquement dans ce fichier, sur le serveur.
GOOGLE_PHOTOS_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PHOTOS_DAILY_CAP=30
# Photos envoyées par les curateurs : dossier local + adresse publique de l'API
MEDIA_DIR=media
PUBLIC_BASE_URL=http://localhost:8000

# E-mails (mot de passe oublié). none = aucun envoi (en développement, le code apparaît dans les journaux de l'API).
MAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Sortie <no-reply@sortie.app>
