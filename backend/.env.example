# Copier en .env et adapter. Ne jamais committer le .env.
APP_NAME=Sortie
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://sortie:sortie@localhost:5432/sortie
# Obligatoire en production : chaîne aléatoire longue (ex. `openssl rand -hex 32`)
JWT_SECRET=dev-only-change-me-please-32-bytes-min
CORS_ORIGINS=http://localhost:3000
TIMEZONE=Africa/Abidjan
DEFAULT_CITY=abidjan

# Itinéraires : none (aucun temps de trajet affiché) | osrm
ROUTING_PROVIDER=none
OSRM_URL=
# Concierge IA : none (mode règles) | anthropic — clé uniquement côté serveur
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Paiement : none tant qu'aucun agrégateur Mobile Money n'est intégré
PAYMENTS_PROVIDER=none
MAP_PROVIDER=osm
# URL publique du bucket S3 / CDN pour les photos (vide = visuels générés)
MEDIA_BASE_URL=

SEARCH_HISTORY_RETENTION_DAYS=30
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# RAG : hashing (hors ligne, lexical enrichi) | fastembed (sémantique, pip install -r requirements-ai.txt)
EMBEDDINGS_PROVIDER=hashing
# Photos Google (optionnel, payant à l'usage) : servies par proxy, jamais stockées
GOOGLE_PLACES_API_KEY=
