# Nom de code de l'application (un seul endroit à changer).
EXPO_PUBLIC_APP_NAME=Sortie

# URL de l'API. Sur un téléphone physique, « localhost » désigne le téléphone lui-même :
# mettez l'IP de l'ordinateur sur le réseau Wi-Fi local, par ex. http://192.168.1.20:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optionnel : URL publique de l'application web, utilisée pour les liens de partage.
# EXPO_PUBLIC_WEB_URL=https://sortie.example.com
